32_t num_hyps =\n         hyps_row_splits.back();  // total num hyps for all utterance\n     prev.clear();\n-    for (auto &hyps : cur) {\n+    prev_scores.clear();\n+    for (size_t b = 0; b < cur.size(); ++b) {\n+      auto &hyps = cur[b];\n+#if SHERPA_ONNX_NEKO_KWS_MERGE\n+      neko_kws::ValidateScores(hyps, cur_scores[b]);\n+#endif\n       for (auto &h : hyps) {\n+#if SHERPA_ONNX_NEKO_KWS_MERGE\n+        prev_scores.push_back(neko_kws::PathScore(cur_scores[b], h.second));\n+#endif\n         prev.push_back(std::move(h.second));\n       }\n     }\n     cur.clear();\n+    cur_scores.clear();\n     cur.reserve(batch_size);\n\n     Ort::Value decoder_input = model_->BuildDecoderInput(prev);\n@@ -110,6 +121,8 @@\n           TopkIndex(p_logprob, vocab_size * (end - start), max_active_paths_);\n\n       Hypotheses hyps;\n+      std::unordered_map<std::string, Hypothesis> merged;\n+      neko_kws::PathScores next_scores;\n       for (auto k : topk) {\n         int32_t hyp_index = k / vocab_size + start;\n         int32_t new_token = k % vocab_size;\n@@ -141,34 +154,34 @@\n           ++new_hyp.num_trailing_blanks;\n         }\n         new_hyp.log_prob = p_logprob[k] + context_score;\n+#if SHERPA_ONNX_NEKO_KWS_MERGE\n+        const double path_score = prev_scores[hyp_index] +\n+            logprobs[hyp_index * vocab_size + new_token] + context_score;\n+        neko_kws::Add(&merged, &next_scores, std::move(new_hyp), path_score);\n+#else\n         hyps.Add(std::move(new_hyp));\n+#endif\n       }  // for (auto k : topk)\n\n-      auto best_hyp = hyps.GetMostProbable(false);\n-\n-      auto status = ss[b]->GetContextGraph()->IsMatched(best_hyp.context_state);\n-      bool matched = std::get<0>(status);\n-      const ContextState *matched_state = std::get<1>(status);\n-\n-      if (matched) {\n-        float ys_prob = 0.0;\n-        for (int32_t i = 0; i < matched_state->level; ++i) {\n-          ys_prob += best_hyp.ys_probs[i];\n-        }\n-        ys_prob /= matched_state->level;\n-        if (best_hyp.num_trailing_blanks > num_trailing_blanks_ &&\n-            ys_prob >= matched_state->ac_threshold) {\n-          auto &r = (*result)[b];\n-          r.tokens = {best_hyp.ys.end() - matched_state->level,\n-                      best_hyp.ys.end()};\n-          r.timestamps = {best_hyp.timestamps.end() - matched_state->level,\n-                          best_hyp.timestamps.end()};\n-          r.keyword = matched_state->phrase;\n-\n-          hyps = Hypotheses({{blanks, 0, ss[b]->GetContextGraph()->Root()}});\n-        }\n+#if SHERPA_ONNX_NEKO_KWS_MERGE\n+      hyps = Hypotheses(std::move(merged));\n+#endif\n+      const auto match = neko_kws::Select(\n+          hyps, *ss[b]->GetContextGraph(), num_trailing_blanks_,\n+          SHERPA_ONNX_NEKO_KWS_CANDIDATES != 0);\n+      if (match.hypothesis) {\n+        const auto &best_hyp = *match.hypothesis;\n+        const auto n = match.state->level;\n+        auto &r = (*result)[b];\n+        r.tokens = {best_hyp.ys.end() - n, best_hyp.ys.end()};\n+        r.timestamps = {best_hyp.timestamps.end() - n,\n+                        best_hyp.timestamps.end()};\n+        r.keyword = match.state->phrase;\n+        neko_kws::Initialize(&hyps, &next_scores, blanks,\n+                             ss[b]->GetContextGraph()->Root());\n       }\n       cur.push_back(std::move(hyps));\n+      cur_scores.push_back(std::move(next_scores));\n       p_logprob += (end - start) * vocab_size;\n     }  // for (int32_t b = 0; b != batch_size; ++b)\n   }\n@@ -178,6 +191,7 @@\n     auto best_hyp = hyps.GetMostProbable(false);\n     auto &r = (*result)[b];\n     r.hyps = std::move(hyps);\n+    r.alignment_scores = std::move(cur_scores[b]);\n     r.num_trailing_blanks = best_hyp.num_trailing_blanks;\n     r.frame_offset += num_frames;\n   }\n--- a/sherpa-onnx/csrc/CMakeLists.txt\n+++ b/sherpa-onnx/csrc/CMakeLists.txt\n@@ -903,3 +903,26 @@\n   DEPENDS ${sources})\n\n add_custom_target(check DEPENDS clang-tidy-check)\n+\n+# N.E.K.O KWS corrections are always enabled in release wheels. Disabled\n+# variants exist only for explicit, independently identified ablation builds.\n+option(SHERPA_ONNX_NEKO_KWS_MERGE "Preserve whole KWS alignment metadata" ON)\n+option(SHERPA_ONNX_NEKO_KWS_CANDIDATES "Check all eligible KWS candidates" ON)\n+option(SHERPA_ONNX_NEKO_KWS_ABLATION "Allow non-release KWS ablation builds" OFF)\n+option(SHERPA_ONNX_NEKO_KWS_TESTS "Build standalone KWS regression tests" OFF)\n+if(NOT SHERPA_ONNX_NEKO_KWS_ABLATION AND\n+   (NOT SHERPA_ONNX_NEKO_KWS_MERGE OR NOT SHERPA_ONNX_NEKO_KWS_CANDIDATES))\n+  message(FATAL_ERROR "Disabling KWS fixes requires an explicit ablation build")\n+endif()\n+target_compile_definitions(sherpa-onnx-core PRIVATE\n+  SHERPA_ONNX_NEKO_KWS_MERGE=$<BOOL:${SHERPA_ONNX_NEKO_KWS_MERGE}>\n+  SHERPA_ONNX_NEKO_KWS_CANDIDATES=$<BOOL:${SHERPA_ONNX_NEKO_KWS_CANDIDATES}>)\n+if(SHERPA_ONNX_ENABLE_TESTS OR SHERPA_ONNX_NEKO_KWS_TESTS)\n+  enable_testing()\n+  add_executable(neko-kws-decoder-test neko-kws-decoder-test.cc)\n+  target_link_libraries(neko-kws-decoder-test PRIVATE sherpa-onnx-core)\n+  add_test(NAME neko-kws-decoder-test COMMAND $<TARGET_FILE:neko-kws-decoder-test>)\n+  # Real-model fixtures are supplied explicitly; do not silently skip in CTest.\n+  add_executable(neko-kws-lifecycle-test neko-kws-lifecycle-test.cc)\n+  target_link_libraries(neko-kws-lifecycle-test PRIVATE sherpa-onnx-core)\n+endif()\n--- /dev/null\n+++ b/sherpa-onnx/csrc/neko-kws-decoder.h\n@@ -0,0 +1,137 @@\n+// KWS-only alignment bookkeeping and candidate acceptance.\n+// Shared ASR Hypotheses::Add intentionally remains unchanged.\n+#ifndef SHERPA_ONNX_CSRC_NEKO_KWS_DECODER_H_\n+#define SHERPA_ONNX_CSRC_NEKO_KWS_DECODER_H_\n+\n+#include <algorithm>\n+#include <cmath>\n+#include <stdexcept>\n+#include <tuple>\n+#include <unordered_map>\n+#include <utility>\n+\n+#include "sherpa-onnx/csrc/hypothesis.h"\n+\n+namespace sherpa_onnx {\n+namespace neko_kws {\n+\n+using PathScores = std::unordered_map<std::string, double>;\n+\n+// Used only at a genuine empty-stream / accepted-keyword initialization.\n+inline void Initialize(Hypotheses *hyps, PathScores *scores,\n+                       const std::vector<int64_t> &blanks,\n+                       const ContextState *root = nullptr) {\n+  Hypothesis h(blanks, 0, root);\n+  scores->clear();\n+  scores->emplace(h.Key(), 0.0);\n+  *hyps = Hypotheses({std::move(h)});\n+}\n+\n+inline double PathScore(const PathScores &scores, const Hypothesis &h) {\n+  auto it = scores.find(h.Key());\n+  if (it == scores.end()) {\n+    throw std::logic_error("KWS alignment score missing for active hypothesis");\n+  }\n+  if (std::isnan(it->second) || it->second == INFINITY) {\n+    throw std::logic_error("KWS invalid alignment score");\n+  }\n+  return it->second;\n+}\n+\n+inline void ValidateScores(const Hypotheses &hyps, const PathScores &scores) {\n+  if (hyps.Size() != scores.size()) {\n+    throw std::logic_error("KWS hypotheses and alignment scores out of sync");\n+  }\n+  for (const auto &entry : hyps) PathScore(scores, entry.second);\n+}\n+\n+// Equal-score paths use metadata order, never unordered_map iteration order.\n+// Equal token sequences in one deterministic context graph share context state.\n+inline bool EarlierMetadata(const Hypothesis &a, const Hypothesis &b) {\n+  return std::tie(a.timestamps, a.ys_probs, a.num_trailing_blanks) <\n+         std::tie(b.timestamps, b.ys_probs, b.num_trailing_blanks);\n+}\n+\n+inline void Add(std::unordered_map<std::string, Hypothesis> *hyps,\n+                PathScores *scores, Hypothesis h, double path_score) {\n+  if (std::isnan(path_score) || path_score == INFINITY ||\n+      std::isnan(h.log_prob) || h.log_prob == INFINITY) {\n+    throw std::logic_error("KWS invalid merge score");\n+  }\n+  const auto key = h.Key();\n+  auto it = hyps->find(key);\n+  if (it == hyps->end()) {\n+    hyps->emplace(key, std::move(h));\n+    if (!scores->emplace(key, path_score).second) {\n+      throw std::logic_error("KWS orphan alignment score");\n+    }\n+    return;\n+  }\n+  const double old_path_score = PathScore(*scores, it->second);\n+  const double total = LogAdd<double>()(it->second.log_prob, h.log_prob);\n+  if (path_score > old_path_score ||\n+      (path_score == old_path_score && EarlierMetadata(h, it->second))) {\n+    it->second = std::move(h);\n+    scores->at(key) = path_score;\n+  }\n+  it->second.log_prob = total;\n+}\n+\n+inline const ContextState *Eligible(const Hypothesis &h,\n+                                    const ContextGraph &graph,\n+                                    int32_t required_blanks) {\n+  if (!h.context_state || !std::isfinite(h.log_prob)) return nullptr;\n+  const auto status = graph.IsMatched(h.context_state);\n+  const auto *state = status.second;\n+  if (!status.first || !state || state->level <= 0 ||\n+      h.num_trailing_blanks <= required_blanks) return nullptr;\n+  const auto n = static_cast<size_t>(state->level);\n+  if (h.ys.size() < n || h.ys_probs.size() < n || h.timestamps.size() < n ||\n+      !std::isfinite(state->ac_threshold)) return nullptr;\n+  float mean = 0;\n+  // Preserve upstream prefix probability indexing in this change.\n+  for (size_t i = 0; i < n; ++i) {\n+    if (!std::isfinite(h.ys_probs[i]) || h.ys_probs[i] < 0 ||\n+        h.ys_probs[i] > 1) return nullptr;\n+    mean += h.ys_probs[i];\n+  }\n+  auto first = h.timestamps.end() - n;\n+  if (*first < 0 || !std::is_sorted(first, h.timestamps.end())) return nullptr;\n+  return mean / n >= state->ac_threshold ? state : nullptr;\n+}\n+\n+struct Match {\n+  const Hypothesis *hypothesis = nullptr;\n+  const ContextState *state = nullptr;\n+};\n+\n+inline Match Select(const Hypotheses &hyps, const ContextGraph &graph,\n+                    int32_t required_blanks, bool all_candidates) {\n+  Match best;\n+  if (!all_candidates) {\n+    // Preserve upstream ranking/tie behavior in the ablation baseline.\n+    const auto top = hyps.GetMostProbable(false);\n+    for (const auto &entry : hyps) {\n+      if (entry.first == top.Key()) {\n+        const auto *state = Eligible(entry.second, graph, required_blanks);\n+        return {state ? &entry.second : nullptr, state};\n+      }\n+    }\n+    return best;\n+  }\n+  for (const auto &entry : hyps) {\n+    const auto &h = entry.second;\n+    auto *state = Eligible(h, graph, required_blanks);\n+    if (state && (!best.hypothesis ||\n+        h.log_prob > best.hypothesis->log_prob ||\n+        (h.log_prob == best.hypothesis->log_prob &&\n+         h.ys < best.hypothesis->ys))) {\n+      best = {&h, state};\n+    }\n+  }\n+  return best;\n+}\n+\n+}  // namespace neko_kws\n+}  // namespace sherpa_onnx\n+#endif  // SHERPA_ONNX_CSRC_NEKO_KWS_DECODER_H_\n--- /dev/null\n+++ b/sherpa-onnx/csrc/neko-kws-decoder-test.cc\n@@ -0,0 +1,168 @@\n+#include "sherpa-onnx/csrc/neko-kws-decoder.h"\n+\n+#include <iostream>\n+#include <limits>\n+#include <stdexcept>\n+\n+using namespace sherpa_onnx;  // NOLINT\n+\n+void Check(bool ok, const char *message) {\n+  if (!ok) throw std::runtime_error(message);\n+}\n+\n+template <typename F>\n+void MustThrow(F f) {\n+  bool caught = false;\n+  try { f(); } catch (const std::logic_error &) { caught = true; }\n+  Check(caught, "corrupt score state did not fail explicitly");\n+}\n+\n+Hypothesis Make(const ContextState *state, double aggregate, float probability,\n+                int32_t time = 2, int32_t blanks = 2) {\n+  Hypothesis h({-1, 0, 1, 2}, aggregate, state);\n+  h.ys_probs = {probability, probability};\n+  h.timestamps = {time, time + 1};\n+  h.num_trailing_blanks = blanks;\n+  return h;\n+}\n+\n+int main() {\n+  try {\n+    ContextGraph graph({{1, 2}}, 1.0f, 0.25f, {}, {"wake"});\n+    auto *prefix = std::get<1>(graph.ForwardOneStep(graph.Root(), 1));\n+    auto *word = std::get<1>(graph.ForwardOneStep(prefix, 2));\n+\n+    // Direct production helper tests: order independence and whole metadata.\n+    for (bool reverse : {false, true}) {\n+      auto weak = Make(word, -3, 0.2f, 10, 4);\n+      auto strong = Make(word, -2, 0.8f, 20, 2);\n+      std::unordered_map<std::string, Hypothesis> merged;\n+      neko_kws::PathScores scores;\n+      neko_kws::Add(&merged, &scores, reverse ? strong : weak, reverse ? -2 : -3);\n+      neko_kws::Add(&merged, &scores, reverse ? weak : strong, reverse ? -3 : -2);\n+      auto h = merged.at(strong.Key());\n+      Check(std::abs(h.log_prob - std::log(std::exp(-3.) + std::exp(-2.))) < 1e-10,\n+            "aggregate score changed");\n+      Check(h.ys_probs == strong.ys_probs && h.timestamps == strong.timestamps &&\n+            h.num_trailing_blanks == strong.num_trailing_blanks &&\n+            h.context_state == strong.context_state, "metadata was mixed");\n+      Check(neko_kws::PathScore(scores, h) == -2, "path became aggregate");\n+      // A competing path beats the representative, but not its aggregate.\n+      auto next = Make(word, -1.8, 0.7f, 30, 3);\n+      neko_kws::Add(&merged, &scores, next, -1.8);\n+      Check(merged.at(next.Key()).timestamps == next.timestamps,\n+            "multi-round merge confused path and aggregate scores");\n+    }\n+    for (bool reverse : {false, true}) {\n+      auto early = Make(word, -2, 0.6f, 4);\n+      auto late = Make(word, -2, 0.9f, 8);\n+      std::unordered_map<std::string, Hypothesis> merged;\n+      neko_kws::PathScores scores;\n+      neko_kws::Add(&merged, &scores, reverse ? early : late, -2);\n+      neko_kws::Add(&merged, &scores, reverse ? late : early, -2);\n+      Check(merged.at(early.Key()).timestamps == early.timestamps,\n+            "equal-score tie depends on merge order");\n+    }\n+\n+    // Boundary counterexample: best whole path is not highest keyword mean.\n+    auto low_mean = Make(word, -1, 0.2f);\n+    auto high_mean = Make(word, -2, 0.9f);\n+    std::unordered_map<std::string, Hypothesis> merged;\n+    neko_kws::PathScores scores;\n+    neko_kws::Add(&merged, &scores, low_mean, -1);\n+    neko_kws::Add(&merged, &scores, high_mean, -2);\n+    Check(!neko_kws::Eligible(merged.at(low_mean.Key()), graph, 1),\n+          "wrongly selected maximum token probabilities");\n+\n+    // First candidate incomplete, second complete: production selection fixes it.\n+    auto valid = Make(word, -2, 0.5f);\n+    auto top = Make(prefix, -1, 0.9f);\n+    top.ys = {-1, 0, 1};\n+    Hypotheses candidates(std::vector<Hypothesis>{top, valid});\n+    Check(!neko_kws::Select(candidates, graph, 1, false).hypothesis,\n+          "baseline unexpectedly accepts second candidate");\n+    auto selected = neko_kws::Select(candidates, graph, 1, true);\n+    Check(selected.hypothesis && selected.hypothesis->Key() == valid.Key(),\n+          "eligible second candidate was missed");\n+    // Invalid candidates cannot bypass confidence / blank / shape checks.\n+    for (int fault = 0; fault < 9; ++fault) {\n+      auto h = valid;\n+      if (fault == 0) h.ys_probs = {0.1f, 0.1f};\n+      if (fault == 1) h.num_trailing_blanks = 1;\n+      if (fault == 2) h.ys_probs.clear();\n+      if (fault == 3) h.timestamps.clear();\n+      if (fault == 4) h.ys_probs[0] = std::numeric_limits<float>::quiet_NaN();\n+      if (fault == 5) h.timestamps = {4, 3};\n+      if (fault == 6) h.timestamps = {-1, 3};\n+      if (fault == 7) h.log_prob = std::numeric_limits<double>::infinity();\n+      if (fault == 8) h.ys.clear();\n+      Check(!neko_kws::Eligible(h, graph, 1), "invalid candidate accepted");\n+    }\n+    auto other = valid;\n+    other.ys.insert(other.ys.begin(), 8);\n+    other.log_prob = -1;\n+    other.timestamps = {10, 11};\n+    Hypotheses two(std::vector<Hypothesis>{valid, other});\n+    selected = neko_kws::Select(two, graph, 1, true);\n+    Check(selected.hypothesis && selected.hypothesis->timestamps == other.timestamps,\n+          "selection did not use highest eligible aggregate or own timestamps");\n+    Check(neko_kws::Select(two, graph, 1, false).hypothesis->Key() == other.Key(),\n+          "first eligible candidate changed");\n+    other.log_prob = valid.log_prob;\n+    for (bool reverse : {false, true}) {\n+      Hypotheses tied(reverse ? std::vector<Hypothesis>{other, valid} :\n+                                std::vector<Hypothesis>{valid, other});\n+      Check(neko_kws::Select(tied, graph, 1, true).hypothesis->ys == valid.ys,\n+            "candidate tie is not deterministic");\n+    }\n+\n+    // Two independent streams and repeated accepted-hit/stream initialization.\n+    Hypotheses stream_a, stream_b;\n+    neko_kws::PathScores scores_a, scores_b;\n+    neko_kws::Initialize(&stream_a, &scores_a, {-1, 0}, graph.Root());\n+    neko_kws::Initialize(&stream_b, &scores_b, {-1, 0}, graph.Root());\n+    for (int repeat = 0; repeat < 3; ++repeat) {\n+      neko_kws::ValidateScores(stream_a, scores_a);\n+      Check(neko_kws::PathScore(scores_a, stream_a.begin()->second) == 0,\n+            "empty stream score not zero");\n+      scores_a.begin()->second = -20;\n+      Check(scores_b.begin()->second == 0, "stream score leakage");\n+      neko_kws::Initialize(&stream_a, &scores_a, {-1, 0}, graph.Root());\n+      Check(stream_a.Size() == 1 && scores_a.size() == 1, "reset leaked state");\n+    }\n+    scores_a.clear();\n+    MustThrow([&] { neko_kws::PathScore(scores_a, stream_a.begin()->second); });\n+    MustThrow([&] { neko_kws::ValidateScores(stream_a, scores_a); });\n+    scores_a.emplace("orphan", 0);\n+    MustThrow([&] { neko_kws::ValidateScores(stream_a, scores_a); });\n+    // Returning to context root forgets tokens, but is not a new stream:\n+    // preserve the complete path score rather than silently reseeding zero.\n+    Hypothesis root_path({-1, 0}, -12, graph.Root());\n+    merged.clear(); scores.clear();\n+    neko_kws::Add(&merged, &scores, root_path, -15);\n+    Check(neko_kws::PathScore(scores, root_path) == -15,\n+          "context-root transition reseeded the path score");\n+    // Per-frame next maps contain only survivors; no historical scores leak.\n+    for (int frame = 0; frame < 20; ++frame) {\n+      std::unordered_map<std::string, Hypothesis> next;\n+      neko_kws::PathScores next_scores;\n+      auto survivor = merged.begin()->second;\n+      neko_kws::Add(&next, &next_scores, survivor,\n+                    neko_kws::PathScore(scores, survivor) - 0.1);\n+      merged = std::move(next);\n+      scores = std::move(next_scores);\n+      Check(merged.size() == 1 && scores.size() == 1,\n+            "next-frame score storage grew with history");\n+    }\n+    // Preserve the currently shipped prefix-probability policy explicitly.\n+    auto prefix_probability = valid;\n+    prefix_probability.ys_probs = {0.1f, 0.1f, 0.9f, 0.9f};\n+    Check(!neko_kws::Eligible(prefix_probability, graph, 1),\n+          "this change silently switched prefix probabilities to suffix");\n+    std::cout << "KWS production helper regressions passed\n";\n+  } catch (const std::exception &e) {\n+    std::cerr << e.what() << '\n';\n+    return 1;\n+  }\n+  return 0;\n+}\n--- /dev/null\n+++ b/sherpa-onnx/csrc/neko-kws-lifecycle-test.cc\n@@ -0,0 +1,193 @@\n+#include <algorithm>\n+#include <cmath>\n+#include <iostream>\n+#include <memory>\n+#include <stdexcept>\n+#include <string>\n+#include <vector>\n+\n+#include <nlohmann/json.hpp>\n+#include "sherpa-onnx/csrc/keyword-spotter.h"\n+#include "sherpa-onnx/csrc/transducer-keyword-decoder.h"\n+#include "sherpa-onnx/csrc/wave-reader.h"\n+\n+using namespace sherpa_onnx;  // NOLINT\n+using nlohmann::json;\n+\n+void Require(bool value, const char *message) {\n+  if (!value) throw std::runtime_error(message);\n+}\n+\n+struct Input {\n+  std::string name;\n+  std::vector<float> pcm;\n+  std::vector<std::pair<float, float>> calls;\n+};\n+\n+void Append(Input *input, const std::vector<float> &pcm, float silence) {\n+  input->pcm.resize(input->pcm.size() + static_cast<size_t>(16000 * silence));\n+  float start = input->pcm.size() / 16000.f;\n+  input->pcm.insert(input->pcm.end(), pcm.begin(), pcm.end());\n+  input->calls.push_back({start, input->pcm.size() / 16000.f});\n+}\n+\n+struct Live {\n+  std::unique_ptr<OnlineStream> stream;\n+  size_t offset = 0;\n+  std::vector<KeywordResult> hits;\n+  int reset_conditions = 0;\n+  int confirmed_silence_resets = 0;\n+  int explicit_resets = 0;\n+  int max_hyps = 0;\n+};\n+\n+json Run(KeywordSpotter *spotter, const std::vector<Input> &inputs, bool batch,\n+         bool explicit_reset, const std::vector<size_t> &chunks) {\n+  std::vector<Live> streams(inputs.size());\n+  for (auto &s : streams) s.stream = spotter->CreateStream();\n+  int batch_two_calls = 0;\n+  for (;;) {\n+    bool fed = false;\n+    for (size_t i = 0; i < streams.size(); ++i) {\n+      auto &s = streams[i];\n+      size_t count = std::min(chunks[i], inputs[i].pcm.size() - s.offset);\n+      if (count) {\n+        s.stream->AcceptWaveform(16000, inputs[i].pcm.data() + s.offset, count);\n+        s.offset += count;\n+        fed = true;\n+      }\n+    }\n+    for (;;) {\n+      std::vector<OnlineStream *> ready;\n+      std::vector<size_t> indices;\n+      std::vector<int> old_frames;\n+      std::vector<bool> silence_reset_expected;\n+      for (size_t i = 0; i < streams.size(); ++i) {\n+        auto &s = streams[i];\n+        if (spotter->IsReady(s.stream.get())) {\n+          ready.push_back(s.stream.get()); indices.push_back(i);\n+          auto &r = s.stream->GetKeywordResult(false);\n+          old_frames.push_back(r.frame_offset);\n+          silence_reset_expected.push_back(explicit_reset && r.num_trailing_blanks * 0.04f > 1.5f);\n+          // This is the condition used by native automatic silence Reset.\n+          if (r.num_trailing_blanks * 0.04f > 1.5f) ++s.reset_conditions;\n+          if (!batch) break;\n+        }\n+      }\n+      if (ready.empty()) break;\n+      if (ready.size() == 2) ++batch_two_calls;\n+      spotter->DecodeStreams(ready.data(), ready.size());\n+      for (size_t j = 0; j < ready.size(); ++j) {\n+        auto &s = streams[indices[j]];\n+        auto &state = s.stream->GetKeywordResult(false);\n+        Require(state.frame_offset > old_frames[j], "frame clock failed across decode/reset");\n+        if (silence_reset_expected[j]) {\n+          Require(state.num_trailing_blanks <= state.frame_offset - old_frames[j],\n+                  "silence reset did not clear old trailing blank state");\n+          ++s.confirmed_silence_resets;\n+        }\n+        neko_kws::ValidateScores(state.hyps, state.alignment_scores);\n+        Require(state.hyps.Size() <= 8 && state.hyps.Size() > 0, "beam storage unbounded");\n+        s.max_hyps = std::max(s.max_hyps, state.hyps.Size());\n+        auto result = spotter->GetResult(s.stream.get());  // exactly one consuming read\n+        if (!result.keyword.empty()) {\n+          Require(!result.timestamps.empty(), "hit has no timestamps");\n+          Require(std::is_sorted(result.timestamps.begin(), result.timestamps.end()),\n+                  "hit timestamps not monotonic");\n+          if (!s.hits.empty()) Require(result.timestamps.front() > s.hits.back().timestamps.back(),\n+                                       "repeated hit overlaps prior keyword");\n+          s.hits.push_back(result);\n+          if (explicit_reset) {\n+            int clock = state.frame_offset;\n+            spotter->Reset(s.stream.get());\n+            auto &empty = s.stream->GetKeywordResult(false);\n+            Require(empty.frame_offset == clock, "explicit reset lost cumulative clock");\n+            Require(empty.hyps.Size() == 1 && empty.alignment_scores.size() == 1,\n+                    "explicit reset retained old candidates");\n+            Require(empty.alignment_scores.begin()->second == 0,\n+                    "explicit reset failed to reseed empty alignment");\n+            ++s.explicit_resets;\n+          }\n+        }\n+      }\n+    }\n+    if (!fed) break;\n+  }\n+  json rows = json::array();\n+  for (size_t i = 0; i < streams.size(); ++i) {\n+    auto &s = streams[i];\n+    std::vector<int> counts(inputs[i].calls.size());\n+    json hits = json::array();\n+    for (const auto &h : s.hits) {\n+      int matched = -1;\n+      for (size_t k = 0; k < inputs[i].calls.size(); ++k) {\n+        const auto &interval = inputs[i].calls[k];\n+        if (h.timestamps.front() >= interval.first && h.timestamps.back() <= interval.second) {\n+          Require(matched == -1, "hit maps to two calls"); matched = k;\n+        }\n+      }\n+      Require(matched >= 0, "hit outside original utterance interval");\n+      ++counts[matched];\n+      hits.push_back(json::parse(h.AsJsonString()));\n+    }\n+    for (auto count : counts) Require(count == 1, "call missed or duplicated");\n+    rows.push_back({{"name", inputs[i].name}, {"duration", inputs[i].pcm.size()/16000.0},\n+                    {"calls", inputs[i].calls}, {"hits", hits},\n+                    {"trailing_blank_condition_observations", s.reset_conditions},\n+                    {"confirmed_silence_resets", s.confirmed_silence_resets},\n+                    {"explicit_resets", s.explicit_resets}, {"max_hypotheses", s.max_hyps}});\n+  }\n+  if (batch && inputs.size() == 2) Require(batch_two_calls > 0, "no actual batch-two decode");\n+  return {{"batch", batch}, {"explicit_reset", explicit_reset},\n+          {"chunks", chunks}, {"batch_two_decode_calls", batch_two_calls}, {"streams", rows}};\n+}\n+\n+int main(int argc, char **argv) {\n+  try {\n+    ParseOptions options(\n+        "Native KWS lifecycle regression. Supply the same model flags as "\n+        "sherpa-onnx-keyword-spotter followed by three positive PCM16 mono "\n+        "16kHz WAVs: NAME.wav COMMAND.wav ACCEPTED_NEAR.wav. Requires a "\n+        "combined-fix library and --max-active-paths=8. The WAVs must include "\n+        "their natural recorded endings; this harness adds no tail padding.");\n+    KeywordSpotterConfig config;\n+    config.Register(&options);\n+    options.Read(argc, argv);\n+    Require(config.Validate(), "invalid config");\n+    Require(config.max_active_paths == 8, "lifecycle fixture contract requires paths=8");\n+    KeywordSpotter spotter(config);\n+    std::vector<std::vector<float>> clips;\n+    for (int i = 1; i <= options.NumArgs(); ++i) {\n+      int rate = 0; bool ok = false;\n+      clips.push_back(ReadWave(options.GetArg(i), &rate, &ok));\n+      Require(ok && rate == 16000, "invalid input wave");\n+    }\n+    Require(clips.size() == 3, "need name command near WAVs");\n+    json runs = json::array();\n+    // No tail padding and no InputFinished calls: only original WAV content.\n+    for (int prefix : {0, 12, 45}) {\n+      Input input; input.name = "name-prefix" + std::to_string(prefix);\n+      Append(&input, clips[0], prefix);\n+      runs.push_back(Run(&spotter, {input}, false, true, {320}));\n+      std::cerr << "prefix " << prefix << " passed\n";\n+    }\n+    Input a; a.name = "repeated-name-command-near";\n+    Append(&a, clips[0], 12); Append(&a, clips[1], 2); Append(&a, clips[2], 2);\n+    Input b; b.name = "independent-near-name-command";\n+    Append(&b, clips[2], 0); Append(&b, clips[0], 45); Append(&b, clips[1], 2);\n+    for (bool reset : {false, true}) {\n+      runs.push_back(Run(&spotter, {a, b}, false, reset, {320, 960}));\n+      runs.push_back(Run(&spotter, {a, b}, true, reset, {320, 960}));\n+      std::cerr << "repeated and batch reset=" << reset << " passed\n";\n+    }\n+    std::cout << json({{"status", "passed"}, {"runs", runs},\n+                       {"threshold", config.keywords_threshold},\n+                       {"keywords_score", config.keywords_score},\n+                       {"max_active_paths", config.max_active_paths},\n+                       {"num_trailing_blanks", config.num_trailing_blanks},\n+                       {"tail_padding_samples", 0}, {"input_finished", false}}).dump(2) << '\n';\n+  } catch (const std::exception &e) {\n+    std::cerr << "FAILED: " << e.what() << '\n';\n+    return 1;\n+  }\n+}\n