+const test=require('node:test');
+const assert=require('node:assert/strict');
+const fs=require('node:fs');
+const vm=require('node:vm');
+const path=require('node:path');
+test('QA guard refuses capture, retains text IPC and keeps every content muted',async()=>{
+  const appEvents={},events={},handlers=new Map(),switches=[]; let check,request,display,snapshot;
+  const session={setPermissionRequestHandler(fn){request=fn;},setPermissionCheckHandler(fn){check=fn;},setDisplayMediaRequestHandler(fn){display=fn;},registerPreloadScript(){}};
+  const contents={id:1,session,muted:false,isDestroyed:()=>false,setAudioMuted(v){this.muted=v;},isAudioMuted(){return this.muted;},on(n,f){events[n]=f;}};
+  const electron={app:{isPackaged:true,commandLine:{appendSwitch(v){switches.push(v);}},on(n,f){appEvents[n]=f;},whenReady:()=>Promise.resolve(),getPath:()=>'/qa-profile'},session:{defaultSession:session},desktopCapturer:{getSources(){assert.fail('real capture reached');}},webContents:{getAllWebContents:()=>[contents]},ipcMain:{handle(n,f){handlers.set(n,f);},on(){}}};
+  const context={__dirname:path.join(__dirname,'../src'),module:{exports:{}},require(n){return n==='node:fs'?{mkdirSync(){},writeFileSync(_p,text){snapshot=JSON.parse(text);}}:require(n);},setInterval(){return {unref(){}};}};
+  vm.runInNewContext(fs.readFileSync(path.join(__dirname,'../src/acceptance-safety.js'),'utf8'),context);
+  context.module.exports.arm(electron); await Promise.resolve();
+  appEvents['web-contents-created'](null,contents);
+  assert.deepEqual(switches,['mute-audio']); assert.equal(contents.muted,true);
+  assert.equal(check(null,'media'),false); let accepted; request(null,'media',v=>accepted=v); assert.equal(accepted,false);
+  display({},value=>assert.deepEqual(JSON.parse(JSON.stringify(value)),{}));
+  await assert.rejects(electron.desktopCapturer.getSources(),{name:'NotAllowedError'});
+  electron.ipcMain.handle('capture-desktop',()=>assert.fail('screen IPC reached'));
+  await assert.rejects(handlers.get('capture-desktop')(),{name:'NotAllowedError'});
+  const textHandler=value=>value; electron.ipcMain.handle('text-submit',textHandler); assert.equal(handlers.get('text-submit'),textHandler);
+  assert.equal(snapshot.is_packaged,true);
+});
